# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=groq            # groq | openai | gemini | custom
GROQ_API_KEY=your_groq_api_key_here                # your key for the chosen provider (GROQ_API_KEY also works for groq)

# Optional overrides (defaults come from config.py)
# CHAT_MODEL=
# EMBEDDING_BACKEND=local     # local (free, no key) | api  -- groq defaults to local
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=            # only for EMBEDDING_BACKEND=api
# LLM_BASE_URL=               # only needed for provider=custom
